# انسخ هالملف باسم .env.local وعبّي القيم الحقيقية محلياً (ما تعمل commit لـ .env.local أبداً)

# مطلوب دايماً — سر توقيع JWT، لازم يكون 32 حرف أو أكثر (lib/auth.ts بيرمي خطأ لو أقصر)
JWT_SECRET=

# مطلوب دايماً — بيُستخدم لعمل seed لحساب الأدمن الأول بس (أول مرة ما كان موجود بقاعدة البيانات)
ADMIN_PASSWORD=

# اختياري محلياً، مطلوب بالإنتاج (Vercel) — لو فاضيين بيستخدم SQLite محلي تلقائياً بـ data/billy.db
TURSO_URL=
TURSO_AUTH_TOKEN=

# مطلوب لميزة رفع الصور بلوحة التحكم (/api/upload) — بدونها بيرجع خطأ 500
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
