# انسخ هالملف باسم .env.local وعبّي القيم الحقيقية محلياً (ما تعمل commit لـ .env.local أبداً)

# مطلوب دايماً — سر توقيع JWT، لازم يكون 32 حرف أو أكثر (lib/auth.ts بيرمي خطأ لو أقصر)
JWT_SECRET=

# مطلوب دايماً — بيُستخدم لعمل seed لحساب الأدمن الأول بس (أول مرة ما كان موجود بقاعدة البيانات)
ADMIN_PASSWORD=

# اختياري محلياً، مطلوب بالإنتاج (Vercel) — لو فاضيين بيستخدم SQLite محلي تلقائياً بـ data/billy.db
TURSO_URL=
TURSO_AUTH_TOKEN=

# مطلوب لميزة رفع الصور بلوحة التحكم (/api/upload) — بدونها بيرجع خطأ 500
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# مطلوب لتشغيل المساعد الذكي بلوحة التحكم (المزوّد الأساسي) — عبر NVIDIA NIM
# بدونه، المساعد يحاول المزوّد الاحتياطي (Groq) مباشرة — احصل عليه من https://build.nvidia.com
NVIDIA_NIM_API_KEY=

# مطلوب كمزوّد احتياطي للمساعد الذكي (يُستخدم تلقائياً لو فشل NVIDIA NIM أو تجاوز الحد المسموح)
# احصل عليه من https://console.groq.com/keys
GROQ_API_KEY=

# اختياري — تجاوز موديل NVIDIA NIM الافتراضي (nvidia/llama-3.3-nemotron-super-49b-v1.5) لأغراض
# قياس/مقارنة السرعة فقط — لا يؤثر على Groq (المزوّد الاحتياطي) إطلاقاً
ASSISTANT_MODEL=

# اختياري — يُرسَل كرسالة نظام (system) منفصلة قبل برومبت المساعد الفعلي لتجربة تعطيل التفكير
# التفصيلي لموديلات Nemotron (القيم المُختبَرة: "detailed thinking off" أو "/no_think" — التوثيق
# الرسمي غير حاسم بينهم، القياس الفعلي هو الفيصل). فاضي = بدون أي رسالة إضافية (السلوك الحالي).
ASSISTANT_THINKING_DIRECTIVE=

# اختياري — مفتاح Google Gemini API لميزة تكثيف/إعادة صياغة وصف اللعبة عند findGameInfo (وليس محادثة
# المساعد نفسها — تلك صارت عبر NVIDIA_NIM_API_KEY/GROQ_API_KEY أعلاه)
# بدونه، إعادة صياغة الوصف ترجع خطأ واضح بدل ما تفشل بصمت — احصل عليه من https://aistudio.google.com/apikey
GEMINI_API_KEY=

# اختياري — مفتاح RAWG Video Games Database API لأداة findGameInfo بالمساعد الذكي (جلب وصف/صورة لعبة تلقائياً)
# بدونه، الأداة ترجع خطأ واضح للمساعد بدل ما تفشل بصمت — احصل عليه مجاناً من https://rawg.io/apidocs ("Get API Key")
RAWG_API_KEY=

# اختياري — رابط الإنتاج الفعلي (يُستخدم لبناء metadataBase وcanonical/OG tags وsitemap.xml)
# لو فاضي، الكود يستخدم https://billy-store.vercel.app كقيمة افتراضية
NEXT_PUBLIC_SITE_URL=
